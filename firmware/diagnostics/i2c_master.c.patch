+static int trace_rows[12][7];
+static unsigned trace_count;
+static bool trace_active;
+static _Atomic uint32_t trace_irq_mask;
+static _Atomic bool trace_irq_active;
+unsigned lockensTraceIrq(void) { return atomic_load(&trace_irq_mask); }
+unsigned lockensTraceIrqTimeout(void) { return I2C_LL_INTR_TIMEOUT; }
+unsigned lockensTraceIrqArbitration(void) { return I2C_LL_INTR_ARBITRATION; }
+void lockensTraceArm(void) { trace_count = 0; trace_active = true; atomic_store(&trace_irq_mask, 0); atomic_store(&trace_irq_active, true); }
+void lockensTraceStop(void) { trace_active = false; atomic_store(&trace_irq_active, false); }
+unsigned lockensTraceCount(void) { return trace_count; }
+int lockensTraceValue(unsigned row, unsigned col) { return row < trace_count && col < 7 ? trace_rows[row][col] : -999; }
+static void lockensTrace(i2c_master_bus_handle_t bus, int phase, int rc) {
+    if (!trace_active || trace_count >= 12) return;
+    int *row = trace_rows[trace_count++];
+    row[0]=phase; row[1]=rc; row[2]=atomic_load(&bus->status); row[3]=bus->event;
+    row[4]=i2c_ll_is_bus_busy(bus->base->hal.dev);
+    row[5]=gpio_get_level(bus->base->scl_num); row[6]=gpio_get_level(bus->base->sda_num);
+}
